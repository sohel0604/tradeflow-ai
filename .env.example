# =============================================================================
# TradeFlow AI — Environment Variables Template
#
# HOW TO USE:
#   cp .env.example .env
#   Fill in real values in .env
#   NEVER commit .env to GitHub
#
# GENERATE SECURE KEYS with:
#   APP_SECRET_KEY  → python3 -c "import secrets; print(secrets.token_hex(32))"
#   JWT_SECRET_KEY  → python3 -c "import secrets; print(secrets.token_hex(64))"
#   ENCRYPTION_KEY  → python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# =============================================================================

# --- App ---
APP_ENV=development
APP_SECRET_KEY=generate-with-secrets-token-hex-32
DEBUG=true
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=tradeflow
POSTGRES_USER=tradeflow
POSTGRES_PASSWORD=your-postgres-password
DATABASE_URL=postgresql+asyncpg://tradeflow:your-postgres-password@postgres:5432/tradeflow
DATABASE_URL_SYNC=postgresql://tradeflow:your-postgres-password@postgres:5432/tradeflow

# --- MongoDB ---
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB=tradeflow
MONGO_USER=tradeflow
MONGO_PASSWORD=your-mongo-password
MONGO_URI=mongodb://tradeflow:your-mongo-password@mongodb:27017/tradeflow

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_URL=redis://:your-redis-password@redis:6379/0

# --- Celery (added Day 31) ---
CELERY_BROKER_URL=redis://:your-redis-password@redis:6379/0
CELERY_RESULT_BACKEND=redis://:your-redis-password@redis:6379/1
CELERY_WORKER_CONCURRENCY=4
CELERY_TIMEZONE=Asia/Kolkata

# --- JWT (added Day 78) ---
JWT_SECRET_KEY=generate-with-secrets-token-hex-64
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- AWS S3 (added Day 70) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=tradeflow-charts
CLOUDFRONT_DOMAIN=

# --- Anthropic Claude (added Day 61) ---
ANTHROPIC_API_KEY=

# --- SendGrid (added Day 72) ---
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@tradeflow.ai
ALERT_EMAIL=ops@tradeflow.ai

# --- Telegram (added Day 74) ---
TELEGRAM_BOT_TOKEN=

# --- Slack (added Day 76) ---
SLACK_OPS_WEBHOOK_URL=

# --- Stripe (added Day 82) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Razorpay (added Day 83) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Dhan Broker (added Day 94) ---
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# --- Encryption key (added Day 95) ---
ENCRYPTION_KEY=generate-with-fernet

# --- Charts ---
CHARTS_DIR=/app/charts
CHARTS_BASE_URL=http://localhost:8000/charts
