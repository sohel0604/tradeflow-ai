# =============================================================================
# TradeFlow AI — Environment Variables Template
#
# HOW TO USE:
#   cp .env.example .env
#   Then fill in real values in .env
#
# IMPORTANT:
#   .env is in .gitignore — it will NEVER be committed to GitHub
#   .env.example IS committed — it documents what variables are needed
# =============================================================================

# --- App ---
APP_ENV=development
APP_SECRET_KEY=change-me-use-openssl-rand-hex-32
DEBUG=true
LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=tradeflow
POSTGRES_USER=tradeflow
POSTGRES_PASSWORD=tradeflow123

# --- MongoDB (added Day 4) ---
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB=tradeflow
MONGO_USER=tradeflow
MONGO_PASSWORD=tradeflow123

# --- Redis (added Day 4) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=tradeflow123

# --- Celery (added Day 31) ---
CELERY_BROKER_URL=redis://:tradeflow123@redis:6379/0
CELERY_RESULT_BACKEND=redis://:tradeflow123@redis:6379/1
CELERY_WORKER_CONCURRENCY=4
CELERY_TIMEZONE=Asia/Kolkata

# --- JWT (added Day 78) ---
JWT_SECRET_KEY=change-me-use-openssl-rand-hex-64
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- AWS S3 (added Day 70) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=tradeflow-charts

# --- Anthropic Claude (added Day 61) ---
ANTHROPIC_API_KEY=

# --- SendGrid (added Day 72) ---
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@tradeflow.ai
ALERT_EMAIL=ops@tradeflow.ai

# --- Telegram (added Day 74) ---
TELEGRAM_BOT_TOKEN=

# --- Slack (added Day 76) ---
SLACK_OPS_WEBHOOK_URL=

# --- Stripe (added Day 82) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Razorpay (added Day 83) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Dhan Broker (added Day 94) ---
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# --- Encryption (added Day 95) ---
ENCRYPTION_KEY=change-me-run-python-fernet-generate-key
